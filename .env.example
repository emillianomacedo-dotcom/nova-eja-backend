# Servidor
PORT=3000
NODE_ENV=development

# CORS - dominios do frontend autorizados (separar por virgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:53906,http://127.0.0.1:3000

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# IA - Provedor ativo: "gemini" ou "openai"
IA_PROVEDOR=gemini

# Google Gemini (gratuito - https://aistudio.google.com/apikey)
GEMINI_API_KEY=COLE_AQUI_SUA_CHAVE_GEMINI
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (opcional - para trocar de provedor depois)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
